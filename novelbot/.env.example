# =====================================================================
#  Novel Name Converter Bot  -  environment template
#  Copy to `.env` for local use. On Render, add each key in the
#  dashboard (Environment tab) or via render.yaml.
#  NEVER commit the real .env file.
# =====================================================================

# ---------- Telegram (REQUIRED) ----------
# https://my.telegram.org/apps  ->  API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=replace_with_your_api_hash
# @BotFather -> /newbot
BOT_TOKEN=123456:ABC-replace_with_your_bot_token
# Set to false to boot ONLY the web service + Mini App (no Telegram login).
# Useful for local UI previews / CI. Keep true in production.
BOT_ENABLED=true

# ---------- Web / Render ----------
# Render injects PORT automatically; keep this only for local runs.
PORT=8000
# Force an explicit public URL (Render also injects RENDER_EXTERNAL_URL).
# PUBLIC_URL=https://your-service.onrender.com
# Telegram Mini App URL (must be HTTPS). Leave empty to disable the menu button.
# MINI_APP_URL=https://your-service.onrender.com/
RETURN_TO_BOT=https://t.me/YourBotUsername

# ---------- Supabase (OPTIONAL but recommended) ----------
# Metadata only: users, jobs, settings, mapping versions.
# Novel text / uploaded files are NEVER stored.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...
SUPABASE_TIMEOUT=8
SUPABASE_MAX_RETRIES=3
SUPABASE_ENABLED=true

# ---------- Limits / behaviour ----------
MAX_FILE_MB=20
MAX_FILE_CHARS=4000000
RATE_LIMIT_PER_HOUR=20
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=240
# Max size of the merged name mapping (curated + names discovered in the novel)
MAX_PAIRS=1500
# How often a candidate name must appear before it is accepted as a character
DISCOVERY_THRESHOLD=3
LOG_LEVEL=INFO
LOG_JSON=true

# ---------- Name sources ----------
# Bundled local lists are always used (offline-safe, no 404s).
# Optional extra sources (newline separated). A dead URL is skipped, not fatal.
# NAMES_REMOTE_URLS=https://example.com/chinese_names.txt,https://example.com/indian_names.txt
NAMES_VERSION=v2
NAMES_SEED=novelbot-v2
ALLOW_LATIN_SINGLE_TOKEN=true

# ---------- Admin ----------
# Comma separated Telegram user IDs that can use /admin commands.
ADMIN_IDS=

# ---------- Keep-alive ----------
KEEPALIVE_ENABLED=true
KEEPALIVE_INTERVAL=600
